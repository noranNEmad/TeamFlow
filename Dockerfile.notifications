FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

COPY src/TeamFlow.Notifications/*.csproj ./src/TeamFlow.Notifications/
RUN dotnet restore src/TeamFlow.Notifications/TeamFlow.Notifications.csproj

COPY src/TeamFlow.Notifications/ ./src/TeamFlow.Notifications/
WORKDIR /app/src/TeamFlow.Notifications
RUN dotnet publish -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app
COPY --from=build /out .
EXPOSE 5050
ENV ASPNETCORE_URLS=http://+:5050
ENTRYPOINT ["dotnet", "TeamFlow.Notifications.dll"]
