{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "signalr-route": {
        "ClusterId": "core-api-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "core-api-route": {
        "ClusterId": "core-api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "core-api-cluster": {
        "Destinations": {
          "core-api-destination": {
            "Address": "http://localhost:5100"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-destination": {
            "Address": "http://localhost:5050"
          }
        }
      }
    }
  }
}
