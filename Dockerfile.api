FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy solution and project files
COPY TeamFlow.slnx ./
COPY src/TeamFlow.Domain/*.csproj ./src/TeamFlow.Domain/
COPY src/TeamFlow.Application/*.csproj ./src/TeamFlow.Application/
COPY src/TeamFlow.Infrastructure/*.csproj ./src/TeamFlow.Infrastructure/
COPY src/TeamFlow.API/*.csproj ./src/TeamFlow.API/

RUN dotnet restore src/TeamFlow.API/TeamFlow.API.csproj

# Copy source code and publish
COPY src/ ./src/
WORKDIR /app/src/TeamFlow.API
RUN dotnet publish -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app
COPY --from=build /out .
EXPOSE 5100
ENV ASPNETCORE_URLS=http://+:5100
ENTRYPOINT ["dotnet", "TeamFlow.API.dll"]
