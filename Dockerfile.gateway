FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

COPY src/TeamFlow.Gateway/*.csproj ./src/TeamFlow.Gateway/
RUN dotnet restore src/TeamFlow.Gateway/TeamFlow.Gateway.csproj

COPY src/TeamFlow.Gateway/ ./src/TeamFlow.Gateway/
WORKDIR /app/src/TeamFlow.Gateway
RUN dotnet publish -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app
COPY --from=build /out .
EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
ENTRYPOINT ["dotnet", "TeamFlow.Gateway.dll"]
